# PixelShrink AI Environment Configuration

# Maximum upload size in Megabytes (default: 25)
MAX_UPLOAD_SIZE_MB=25

# Default target file size in Megabytes (default: 1)
DEFAULT_TARGET_SIZE_MB=1

# External Background Removal API key (optional)
# e.g., Clipdrop, Remove.bg, or custom AI microservice
BACKGROUND_REMOVAL_API_KEY=

# Background removal provider: 'local' | 'external'
BACKGROUND_REMOVAL_PROVIDER=local
